# Server port
PORT=5173

# Summarizer selection (runner decides at runtime)
SUMMARIZER_PROVIDER=ollama   # or: openai

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# OpenAI (only used when SUMMARIZER_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to the news JSON data file
NEWS_JSON_PATH=./data/stock_news.json
